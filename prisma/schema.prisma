generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookCategory {
  FICTION    @map("fiction")
  NONFICTION @map("nonfiction")

  @@map("book_category")
}

enum BookStatus {
  FINISHED     @map("finished")
  NOT_FINISHED @map("not_finished")

  @@map("book_status")
}

enum ListType {
  OWNED    @map("owned")
  WISHLIST @map("wishlist")

  @@map("list_type")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("verification_token_type")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  name            String
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  books              Book[]
  shelves            Shelf[]
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Book {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  title     String
  subtitle  String?
  author    String
  category  BookCategory
  imageUrl  String?      @map("image_url")
  status    BookStatus   @default(NOT_FINISHED)
  listType  ListType     @default(OWNED) @map("list_type")
  favorite  Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelfBooks ShelfBook[]

  @@unique([userId, title, author])
  @@map("books")
}

model Shelf {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelfBooks ShelfBook[]

  @@unique([userId, name])
  @@map("shelves")
}

model ShelfBook {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shelfId String   @map("shelf_id") @db.Uuid
  bookId  String   @map("book_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([shelfId, bookId])
  @@index([bookId])
  @@map("shelf_books")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}
